# Copy this file to supabase/functions/.env for local development.
# For production, copy to supabase/functions/.env.production and push with
# `supabase secrets set --env-file supabase/functions/.env.production`.
# Never commit either real .env file.
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=MedLedger <alerts@notify.medledger.ng>
APP_ORIGIN=http://localhost:8080,https://medledger.ng,https://www.medledger.ng
APP_URL=https://medledger.ng
